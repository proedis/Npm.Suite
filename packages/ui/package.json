{
  "name": "@proedis/ui",
  "version": "1.0.1",
  "description": "The interface layer of a Proedis frontend: layout primitives, the components that read the token contract, and the machinery behind both",
  "keywords": [
    "proedis",
    "react",
    "tailwind",
    "layout",
    "primitives",
    "responsive"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "rollup --config ../../rollup.config.mjs && cpy 'src/**/*.css' build/esm && cpy 'src/**/*.css' build/cjs"
  },
  "dependencies": {
    "@proedis/react": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@proedis/tsconfig": "^2.0.1",
    "@tanstack/react-table": "9.3.1",
    "cpy-cli": "5.0.0",
    "dayjs": "^1.11.12",
    "rollup": "^4.62.4"
  },
  "proedisMetadata": {
    "reflectPeerDependencies": {
      "@base-ui/react": {
        "range": "^1.7.0",
        "optional": true
      },
      "@tanstack/react-table": {
        "range": "^9.3.1",
        "optional": true
      },
      "dayjs": {
        "range": "^1.11.0",
        "optional": true
      },
      "react": {
        "from": "root",
        "range": ">=19.0.0 <20.0.0"
      },
      "tailwindcss": {
        "range": "^4.1.5"
      }
    },
    "exports": [
      "core",
      "layout",
      "primitives",
      "hooks",
      "display/badge",
      "display/badge-counter",
      "display/badge-dot",
      "display/heading",
      "display/icon-box",
      "display/item",
      "display/labeled-content",
      "display/person",
      "display/surface",
      "actions/accordion",
      "actions/button",
      "actions/copy-button",
      "actions/link",
      "actions/menu",
      "actions/segmented-control",
      "actions/tabs",
      "actions/toggle",
      "actions/tooltip",
      "feedback/alert",
      "feedback/empty-state",
      "feedback/notifications",
      "feedback/progress-bar",
      "forms/checkbox",
      "forms/checkbox-grid",
      "forms/combobox",
      "forms/date-picker",
      "forms/field",
      "forms/field-shell",
      "forms/file-upload",
      "forms/form",
      "forms/multi-select",
      "forms/number-input",
      "forms/password-input",
      "forms/radio",
      "forms/range-date-picker",
      "forms/search-input",
      "forms/select",
      "forms/switch",
      "forms/text-input",
      "forms/textarea",
      "overlays/alert-dialog",
      "overlays/dialog",
      "overlays/drawer",
      "overlays/popover",
      "data/detail",
      "data/filters-bar",
      "data/modal-selector",
      "data/table"
    ],
    "styles": [
      "theme.css",
      "ui.css"
    ],
    "assets": [
      ".css"
    ],
    "sideEffects": false,
    "reactCompiler": true
  }
}
