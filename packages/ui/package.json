{
  "name": "@proedis/ui",
  "version": "1.0.1",
  "description": "The interface layer of a Proedis frontend: layout primitives, the components that read the token contract, and the machinery behind both",
  "keywords": [
    "proedis",
    "react",
    "tailwind",
    "layout",
    "primitives",
    "responsive"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "rollup --config ../../rollup.config.mjs && cpy 'src/**/*.css' build/esm && cpy 'src/**/*.css' build/cjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@proedis/tsconfig": "^2.0.1",
    "cpy-cli": "5.0.0",
    "rollup": "^4.62.4"
  },
  "proedisMetadata": {
    "reflectPeerDependencies": {
      "@base-ui/react": {
        "range": "^1.7.0",
        "optional": true
      },
      "react": {
        "from": "root",
        "range": ">=18.0.0 <20.0.0"
      },
      "tailwindcss": {
        "range": "^4.0.0"
      }
    },
    "exports": [
      "core",
      "layout",
      "components",
      "hooks",
      "interactive/button",
      "interactive/field",
      "interactive/form",
      "interactive/password-input",
      "interactive/search-input",
      "interactive/text-input",
      "interactive/tooltip"
    ],
    "styles": [
      "theme.css",
      "ui.css"
    ],
    "assets": [
      ".css"
    ],
    "sideEffects": false
  }
}
