{
  "name": "@proedis/ui",
  "version": "1.0.1",
  "description": "The interface layer of a Proedis frontend: layout primitives, the components that read the token contract, and the machinery behind both",
  "keywords": [
    "proedis",
    "react",
    "tailwind",
    "layout",
    "primitives",
    "responsive"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "rollup --config ../../rollup.config.mjs && cpy 'src/**/*.css' build/esm && cpy 'src/**/*.css' build/cjs"
  },
  "dependencies": {
    "@proedis/react": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@proedis/tsconfig": "^2.0.1",
    "@tanstack/react-table": "9.3.1",
    "cpy-cli": "5.0.0",
    "dayjs": "^1.11.12",
    "rollup": "^4.62.4"
  },
  "proedisMetadata": {
    "reflectPeerDependencies": {
      "@base-ui/react": {
        "range": "^1.7.0",
        "optional": true
      },
      "@tanstack/react-table": {
        "range": "^9.3.1",
        "optional": true
      },
      "dayjs": {
        "range": "^1.11.0",
        "optional": true
      },
      "react": {
        "from": "root",
        "range": ">=19.0.0 <20.0.0"
      },
      "tailwindcss": {
        "range": "^4.1.5"
      }
    },
    "exports": [
      "core",
      "layout",
      "components",
      "hooks",
      "interactive/alert",
      "interactive/alert-dialog",
      "interactive/button",
      "interactive/checkbox",
      "interactive/checkbox-grid",
      "interactive/collapsible",
      "interactive/combobox",
      "interactive/date-picker",
      "interactive/detail",
      "interactive/dialog",
      "interactive/drawer",
      "interactive/empty-state",
      "interactive/field",
      "interactive/field-shell",
      "interactive/file-upload",
      "interactive/filters-bar",
      "interactive/form",
      "interactive/menu",
      "interactive/modal-selector",
      "interactive/multi-select",
      "interactive/number-input",
      "interactive/password-input",
      "interactive/person",
      "interactive/popover",
      "interactive/radio",
      "interactive/search-input",
      "interactive/segmented-control",
      "interactive/select",
      "interactive/switch",
      "interactive/table",
      "interactive/tabs",
      "interactive/text-input",
      "interactive/textarea",
      "interactive/toast",
      "interactive/toggle",
      "interactive/tooltip"
    ],
    "styles": [
      "theme.css",
      "ui.css"
    ],
    "assets": [
      ".css"
    ],
    "sideEffects": false,
    "reactCompiler": true
  }
}
