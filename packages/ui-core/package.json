{
  "name": "@proedis/ui-core",
  "version": "0.1.0",
  "description": "The headless half of a Tailwind interface: layout primitives, responsive props with a typed scale, and the token contract they read",
  "keywords": [
    "proedis",
    "react",
    "tailwind",
    "layout",
    "primitives",
    "responsive"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "build": "rollup --config ../../rollup.config.mjs && cpy 'src/**/*.css' build/esm && cpy 'src/**/*.css' build/cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@proedis/tsconfig": "^2.0.0",
    "cpy-cli": "5.0.0",
    "rollup": "^4.62.4"
  },
  "proedisMetadata": {
    "reflectPeerDependencies": {
      "react": {
        "from": "root",
        "range": ">=18.0.0 <20.0.0"
      },
      "tailwindcss": {
        "range": "^4.0.0"
      }
    },
    "exports": [
      "hooks"
    ],
    "styles": [
      "ui-core.css",
      "theme.css"
    ],
    "assets": [
      ".css"
    ],
    "sideEffects": false
  }
}
