{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Proedis - Declaration Emit Overlay",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "stripInternal": true
  },
  "exclude": [
    "node_modules",
    "src/**/*.spec.ts*",
    "src/**/*.test.ts*"
  ]
}
