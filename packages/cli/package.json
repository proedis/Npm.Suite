{
  "name": "@proedis/cli",
  "version": "2.0.0",
  "description": "Proedis command line interface to scaffold projects, generate React components and build models from an OpenAPI specification",
  "keywords": [
    "proedis",
    "cli",
    "scaffold",
    "generator",
    "react",
    "openapi",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "proedis": "./cjs/index.js"
  },
  "scripts": {
    "build": "rollup --config ../../rollup.config.mjs && cpy 'src/**/*.ejs' build/cjs"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "commander": "11.1.0",
    "ejs": "3.1.9",
    "glob": "10.3.10",
    "inquirer": "8.2.6",
    "ora": "5.4.1",
    "pretty-error": "4.0.0",
    "yaml": "2.3.4"
  },
  "devDependencies": {
    "@proedis/types": "^2.0.0",
    "@types/ejs": "3.1.5",
    "@types/eslint": "8.44.7",
    "@types/inquirer": "9.0.6",
    "cpy-cli": "5.0.0",
    "rollup": "^4.62.4",
    "type-fest": "4.6.0"
  },
  "proedisMetadata": {
    "noMain": true,
    "buildFormats": [
      "cjs"
    ],
    "assets": [
      ".ejs"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
