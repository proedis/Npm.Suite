import type { EnumsColors } from '@proedis/modeler';


/* --------
 * Exports
 * -------- */
const sharedObjectsColors: EnumsColors = {
<% sharedObjects.forEach(function (s) { %>
  <%- s.name %>: {
  <% s.values.forEach(function (value) { %>
    <%= value %>: 'red',<% }) %>
  },
<% }) %>
};

export default sharedObjectsColors;
