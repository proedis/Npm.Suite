# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE files
.idea

# dependencies
node_modules

# yarn: keep the committed release, patches and plugins, ignore local state
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
out/
build

# build metadata
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# internal unversioned folder
.unversioned
