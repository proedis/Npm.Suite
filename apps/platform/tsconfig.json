{
  "extends": "@proedis/tsconfig/react",
  "compilerOptions": {
    "types": [ "node", "vite/client" ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [ "./src/*" ],
      "@proedis/ui": [ "../../packages/ui/src/index.ts" ],
      "@proedis/ui/*": [ "../../packages/ui/src/*" ],
      "@proedis/form": [ "../../packages/form/src/index.ts" ]
    }
  },
  "include": [
    "src",
    "plugins",
    "vite.config.ts"
  ]
}
